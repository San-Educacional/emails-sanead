<mjml>
  <mj-head>
    <mj-title>Duas graduações pelo preço de uma — San Educacional</mj-title>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Arial, sans-serif" />
      <mj-text font-size="16px" color="#050505" line-height="24px" />
      <mj-button
        background-color="#f84806"
        color="#ffffff"
        border-radius="999px"
        font-weight="700"
      />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#bb0185" width="602px">
    <!-- Header -->
    <mj-section background-color="#bb0185" padding="28px 0px 30px">
      <mj-column>
        <mj-image
          src="https://imghost.saneducacional.com.br/3ZOcg.png"
          alt="San Educacional"
          width="220px"
          align="center"
          padding="0px"
        />
      </mj-column>
    </mj-section>

    <!-- Barra de urgência -->
    <mj-section background-color="#f84806" padding="11px 20px">
      <mj-column>
        <mj-text align="center" padding="0px">
          <div
            style="
              font-family: Poppins, Arial, sans-serif;
              font-weight: 700;
              font-size: 13px;
              line-height: 18px;
              color: #ffffff;
              letter-spacing: 1.04px;
              text-align: center;
            "
          >
            ⏰ ÚLTIMO DIA · ENCERRA SEXTA 04/09/2026
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-image
          src="https://imghost.saneducacional.com.br/SZHn1.jpg?w=1200"
          alt="Duas graduações pelo preço de uma — promoção Unicive"
          fluid-on-mobile="true"
          border-radius="22px"
          padding="0px"
        />
      </mj-column>
    </mj-section>

    <!-- Card saudação -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="
              background-color: #bb0185;
              border-radius: 22px;
              padding: 26px 24px 28px;
              text-align: center;
            "
          >
            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-weight: 700;
                font-size: 17px;
                line-height: 26px;
                color: #fff8fd;
                text-align: center;
              "
            >
              {$name|default('Estudante')}, faltam poucas horas para a promoção "Duas graduações pelo preço de uma" se encerrar!
            </div>
            <a
              href="https://mailingredirect.saneducacional.com.br/redirect.php?codlead={$codlead}&amp;produto=04&amp;fornecedor=07&amp;nome_produto=Graduação&amp;curso=000&amp;nome_curso=Graduação"
              style="
                display: inline-block;
                background-color: #f84806;
                color: #ffffff;
                font-family: Poppins, Arial, sans-serif;
                font-weight: 700;
                font-size: 15px;
                border-radius: 999px;
                padding: 15px 34px;
                text-decoration: none;
                margin-top: 22px;
              "
            >
              Quero aproveitar
            </a>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card "Ao fazer" -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="background-color: #f84806; border-radius: 22px; padding: 24px 22px"
          >
            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="border-collapse: collapse"
            >
              <tr>
                <td width="54" valign="middle" style="padding: 0">
                  <div
                    style="
                      width: 54px;
                      height: 54px;
                      background-color: #f96e38;
                      border-radius: 999px;
                      text-align: center;
                      line-height: 54px;
                      font-size: 24px;
                    "
                  >
                    🎓
                  </div>
                </td>
                <td
                  valign="middle"
                  style="
                    padding-left: 14px;
                    font-family: Poppins, Arial, sans-serif;
                    font-weight: 600;
                    font-size: 15px;
                    line-height: 23px;
                    color: #ffffff;
                    text-align: left;
                  "
                >
                  Ao fazer sua graduação pela Unicive, você pode levar uma segunda
                  graduação por apenas R$ 400.
                </td>
              </tr>
            </table>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card preço -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="background-color: #ffffff; border-radius: 22px; padding: 28px 24px"
          >
            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="border-collapse: collapse"
            >
              <tr>
                <td width="45%" valign="middle" style="text-align: center">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 10px;
                      line-height: 14px;
                      color: #9c7e90;
                      letter-spacing: 0.8px;
                      text-align: center;
                    "
                  >
                    1ª GRADUAÇÃO
                  </div>
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 17px;
                      line-height: 24px;
                      color: #050505;
                      letter-spacing: -0.34px;
                      text-align: center;
                      margin-top: 4px;
                    "
                  >
                    valor normal
                  </div>
                </td>
                <td width="10%" valign="middle" style="text-align: center">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 20px;
                      line-height: 24px;
                      color: #f84806;
                      text-align: center;
                    "
                  >
                    +
                  </div>
                </td>
                <td width="45%" valign="middle" style="text-align: center">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 10px;
                      line-height: 14px;
                      color: #bb0185;
                      letter-spacing: 0.8px;
                      text-align: center;
                    "
                  >
                    2ª GRADUAÇÃO
                  </div>
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 24px;
                      line-height: 28px;
                      color: #8d005e;
                      letter-spacing: -0.72px;
                      text-align: center;
                      margin-top: 4px;
                    "
                  >
                    R$ 400
                  </div>
                </td>
              </tr>
            </table>

            <div style="height: 1px; background-color: #f2e4ee; margin: 20px 0"></div>

            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-weight: 400;
                font-size: 15px;
                line-height: 24px;
                color: #3a2c36;
                text-align: center;
              "
            >
              Na prática, você paga o valor normal da sua primeira graduação e
              acrescenta somente R$ 400 para ter uma segunda formação. Assim, você
              sai com duas graduações pelo valor que normalmente estaria pagando por
              apenas uma.
            </div>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card detalhes -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="background-color: #ffffff; border-radius: 22px; padding: 24px 22px"
          >
            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="border-collapse: collapse"
            >
              <tr>
                <td width="34" valign="top" style="padding: 0">
                  <div
                    style="
                      width: 34px;
                      height: 34px;
                      background-color: #fdebf6;
                      border-radius: 999px;
                      text-align: center;
                      line-height: 34px;
                      font-size: 15px;
                    "
                  >
                    ⏰
                  </div>
                </td>
                <td valign="top" style="padding-left: 14px">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 14px;
                      line-height: 19px;
                      color: #050505;
                    "
                  >
                    Prazo:
                  </div>
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 400;
                      font-size: 14px;
                      line-height: 21px;
                      color: #5b4a55;
                      margin-top: 4px;
                    "
                  >
                    depois da meia-noite, essa condição não fica mais garantida e a
                    segunda graduação volta ao valor cheio.
                  </div>
                </td>
              </tr>
            </table>

            <div style="height: 1px; background-color: #f2e4ee; margin: 17px 0"></div>

            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="border-collapse: collapse"
            >
              <tr>
                <td width="34" valign="top" style="padding: 0">
                  <div
                    style="
                      width: 34px;
                      height: 34px;
                      background-color: #fdebf6;
                      border-radius: 999px;
                      text-align: center;
                      line-height: 34px;
                      font-size: 15px;
                    "
                  >
                    ✓
                  </div>
                </td>
                <td valign="top" style="padding-left: 14px">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 14px;
                      line-height: 19px;
                      color: #050505;
                    "
                  >
                    Reconhecido pelo MEC:
                  </div>
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 400;
                      font-size: 14px;
                      line-height: 21px;
                      color: #5b4a55;
                      margin-top: 4px;
                    "
                  >
                    cursos 100% EAD, com validade em todo o Brasil.
                  </div>
                </td>
              </tr>
            </table>

            <div style="height: 1px; background-color: #f2e4ee; margin: 17px 0"></div>

            <table
              role="presentation"
              width="100%"
              cellpadding="0"
              cellspacing="0"
              style="border-collapse: collapse"
            >
              <tr>
                <td width="34" valign="top" style="padding: 0">
                  <div
                    style="
                      width: 34px;
                      height: 34px;
                      background-color: #fdebf6;
                      border-radius: 999px;
                      text-align: center;
                      line-height: 34px;
                      font-size: 15px;
                    "
                  >
                    💬
                  </div>
                </td>
                <td valign="top" style="padding-left: 14px">
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 14px;
                      line-height: 19px;
                      color: #050505;
                    "
                  >
                    Ficou com dúvidas?
                  </div>
                  <div
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 400;
                      font-size: 14px;
                      line-height: 21px;
                      color: #5b4a55;
                      margin-top: 4px;
                    "
                  >
                    fala com a gente no WhatsApp (35) 99119-1475.
                  </div>
                </td>
              </tr>
            </table>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Card CTA final -->
    <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
      <mj-column>
        <mj-text padding="0px">
          <div
            style="
              background-color: #8d005e;
              border-radius: 22px;
              padding: 30px 24px 30px;
              text-align: center;
            "
          >
            <div
              style="
                width: 62px;
                height: 62px;
                background-color: #a42560;
                border-radius: 999px;
                text-align: center;
                line-height: 62px;
                font-size: 28px;
                margin: 0 auto;
              "
            >
              🎓
            </div>
            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-weight: 700;
                font-size: 21px;
                line-height: 28px;
                color: #fff8fd;
                letter-spacing: -0.42px;
                text-align: center;
                margin-top: 20px;
              "
            >
              Se você já estava pensando em fazer uma segunda graduação, essa é a
              hora de aproveitar. A condição termina hoje!
            </div>
            <a
              href="https://mailingredirect.saneducacional.com.br/redirect.php?codlead={$codlead}&amp;produto=04&amp;fornecedor=07&amp;nome_produto=Graduação&amp;curso=000&amp;nome_curso=Graduação"
              style="
                display: block;
                background-color: #fff8fd;
                color: #8d005e;
                font-family: Poppins, Arial, sans-serif;
                font-weight: 700;
                font-size: 15px;
                line-height: 20px;
                border-radius: 999px;
                padding: 16px 24px;
                text-align: center;
                text-decoration: none;
                margin-top: 24px;
              "
            >
              Garantir minhas duas graduações agora
            </a>
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Fine print -->
    <mj-section background-color="#fdfbf5" padding="20px 24px 8px">
      <mj-column>
        <mj-text align="left" padding="0px">
          <div
            style="
              font-family: Poppins, Arial, sans-serif;
              font-weight: 400;
              font-size: 12px;
              line-height: 19px;
              color: #8a7581;
              text-align: left;
            "
          >
            Promoção Segunda Graduação Unicive: matricule-se em uma graduação e leve
            uma segunda por apenas R$ 400. Consulte cursos participantes e condições
            completas com nosso time.
          </div>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer -->
    <mj-section background-color="#8d005e" padding="24px 22px 34px 22px">
      <mj-column>
        <mj-divider border-color="#ad4589" border-width="1px" padding="0px 0px 18px 0px" />
        <mj-text align="center" padding="0px">
          <div style="font-family: Poppins, Arial, sans-serif; font-size: 13px; line-height: 20px; text-align: center">
            <a
              href="{$unsubscribe}"
              style="color: #f0d0e7; text-decoration: underline"
              >Descadastre-se</a
            >
          </div>
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
