<mjml>
  <mj-head>
    <mj-title>Segunda Graduação em Educação Física com Pós grátis — San Educacional</mj-title>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Arial, sans-serif" />
      <mj-text font-size="16px" color="#050505" line-height="24px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#bb0185" width="602px">
    <mj-wrapper padding="0px">
      <!-- Header -->
      <mj-section background-color="#bb0185" padding="28px 0px 30px">
        <mj-column>
          <mj-image
            src="https://imghost.saneducacional.com.br/3ZOcg.png"
            alt="San Educacional"
            width="220px"
            align="center"
            padding="0px"
          />
        </mj-column>
      </mj-section>

      <!-- Hero full-bleed -->
      <mj-section background-color="#fdfbf5" padding="0">
        <mj-column>
          <mj-image
            src="https://imghost.saneducacional.com.br/f3zN5.jpg"
            alt="Segunda Graduação em Educação Física com Pós grátis"
            fluid-on-mobile="true"
            padding="0px"
          />
        </mj-column>
      </mj-section>

      <!-- Card headline -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 20px;
                  line-height: 25px;
                  color: #bb0185;
                "
              >
                {$name|default('Estudante')}, ao fazer sua Segunda Graduação em Educação Física, você ganha uma Pós-graduação!
              </div>
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 400;
                  font-size: 16px;
                  line-height: 24px;
                  color: #050505;
                  margin-top: 16px;
                "
              >
                E ainda escolhe entre várias especializações, como:
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Box magenta lista em pílulas -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #8d005e; border-radius: 22px; padding: 26px 22px"
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 18px;
                  line-height: 25px;
                  color: #ffb765;
                  margin-bottom: 16px;
                "
              >
                Pós-graduação à sua escolha
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                  margin-bottom: 9px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Fisioterapia aplicada às atividades físicas</td>
                  </tr>
                </table>
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                  margin-bottom: 9px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Nutrição Esportiva</td>
                  </tr>
                </table>
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                  margin-bottom: 9px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Psicomotricidade (geral, educação infantil ou educação especial)</td>
                  </tr>
                </table>
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                  margin-bottom: 9px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Fisioterapia em Geriatria e Gerontologia</td>
                  </tr>
                </table>
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                  margin-bottom: 9px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Atenção e Cuidados com Idosos</td>
                  </tr>
                </table>
              </div>

              <div
                style="
                  background-color: #c53d97;
                  border-radius: 14px;
                  padding: 13px 15px;
                "
              >
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="20" valign="top" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; line-height: 21px; color: #ffb765;">✓</td>
                    <td valign="top" style="padding-left: 8px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #fff8fd;">Educação Inclusiva e Educação Especial</td>
                  </tr>
                </table>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Card "faz sentido" -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 400;
                  font-size: 15px;
                  line-height: 24px;
                  color: #3a2c36;
                "
              >
                E faz todo sentido escolher essa disciplina:
                <span style="font-weight: 700">Educação Física faz parte da educação básica brasileira, do ensino fundamental ao ensino médio. A demanda por professores qualificados nunca foi tão alta.</span>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Callout laranja -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #f84806; border-radius: 22px; padding: 24px 22px"
            >
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                <tr>
                  <td width="54" valign="middle" style="padding: 0">
                    <div
                      style="
                        width: 54px;
                        height: 54px;
                        background-color: #fa6a37;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 54px;
                        font-size: 24px;
                      "
                    >
                      🏃
                    </div>
                  </td>
                  <td
                    valign="middle"
                    style="
                      padding-left: 14px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 15px;
                      line-height: 23px;
                      color: #ffffff;
                      text-align: left;
                    "
                  >
                    Amplie suas oportunidades: com essa formação, você pode atuar em escolas, academias, clubes, projetos sociais, clínicas, reabilitação, saúde e muito mais.
                  </td>
                </tr>
              </table>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Card + checklist -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 400;
                  font-size: 15px;
                  line-height: 24px;
                  color: #3a2c36;
                  margin-bottom: 20px;
                "
              >
                Você ainda aproveita disciplinas que já cursou na sua formação anterior, evitando estudar novamente o que já conhece.
              </div>

              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td valign="top" style="padding-left: 12px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #050505;">
                    Diploma reconhecido pelo MEC
                  </td>
                </tr>
              </table>

              <div style="margin-top: 12px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="26" valign="top" style="padding: 0">
                      <div
                        style="
                          width: 26px;
                          height: 26px;
                          background-color: #fdebf6;
                          border-radius: 999px;
                          text-align: center;
                          line-height: 26px;
                          font-size: 12px;
                          color: #bb0185;
                        "
                      >
                        ✓
                      </div>
                    </td>
                    <td valign="top" style="padding-left: 12px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #050505;">
                      Pós-graduação grátis
                    </td>
                  </tr>
                </table>
              </div>

              <div style="margin-top: 12px">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                  <tr>
                    <td width="26" valign="top" style="padding: 0">
                      <div
                        style="
                          width: 26px;
                          height: 26px;
                          background-color: #fdebf6;
                          border-radius: 999px;
                          text-align: center;
                          line-height: 26px;
                          font-size: 12px;
                          color: #bb0185;
                        "
                      >
                        ✓
                      </div>
                    </td>
                    <td valign="top" style="padding-left: 12px; font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 14px; line-height: 21px; color: #050505;">
                      Aproveitamento de disciplinas já cursadas
                    </td>
                  </tr>
                </table>
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Box de fechamento -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="
                background-color: #bb0185;
                border-radius: 22px;
                padding: 30px 24px 30px;
                text-align: center;
              "
            >
              <div
                style="
                  width: 62px;
                  height: 62px;
                  background-color: #c53d97;
                  border-radius: 999px;
                  text-align: center;
                  line-height: 62px;
                  font-size: 28px;
                  margin: 0 auto;
                "
              >
                🎁
              </div>
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 20px;
                  line-height: 27px;
                  color: #fff8fd;
                  letter-spacing: -0.4px;
                  text-align: center;
                  margin-top: 20px;
                "
              >
                Sua primeira graduação já abriu uma porta. Essa aqui abre duas de uma vez,  2ª Graduação e levar uma Pós grátis.
              </div>
              <a
                href="https://mailingredirect.saneducacional.com.br/redirect.php?codlead={$codlead}&amp;produto=10&amp;fornecedor=07&amp;nome_produto=Graduação&amp;curso=000&amp;nome_curso=Educação Física"
                style="
                  display: block;
                  background-color: #fff8fd;
                  color: #8d005e;
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 15px;
                  line-height: 20px;
                  border-radius: 999px;
                  padding: 16px 24px;
                  text-align: center;
                  text-decoration: none;
                  margin-top: 24px;
                  box-shadow: 0 4px 0 #f84806;
                "
              >
                Quero garantir minha pós grátis
              </a>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Card vagas -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 16px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse: collapse">
                <tr>
                  <td style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 14px; color: #050505;">🔥 Vagas preenchidas</td>
                  <td align="right" style="font-family: Poppins, Arial, sans-serif; font-weight: 700; font-size: 22px; color: #f84806; letter-spacing: -0.66px;">30%</td>
                </tr>
              </table>
              <div style="height: 10px; background-color: #f4e3ee; border-radius: 999px; margin-top: 18px;">
                <div style="height: 10px; width: 30%; background-color: #f84806; border-radius: 999px;"></div>
              </div>
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 400;
                  font-size: 13px;
                  line-height: 20px;
                  color: #5b4a55;
                  margin-top: 14px;
                "
              >
                🔥 30% das vagas já foram preenchidas.
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section background-color="#8d005e" padding="24px 22px 34px">
        <mj-column>
          <mj-text align="center" padding="0px">
            <div style="font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 13px; line-height: 19px; color: #f0d0e7; text-align: center;">
              0800 145 2300 ·
            </div>
            <div style="font-family: Poppins, Arial, sans-serif; font-weight: 600; font-size: 13px; line-height: 19px; color: #f0d0e7; text-align: center;">
              @saneducacional
            </div>
          </mj-text>
          <mj-divider border-color="#ad4589" border-width="1px" padding="18px 0" />
          <mj-text align="center" padding="0px">
            <div style="font-family: Poppins, Arial, sans-serif; font-size: 13px; line-height: 19px; text-align: center">
              <a href="{$unsubscribe}" style="color: #f0d0e7; text-decoration: underline">Descadastre-se</a>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
