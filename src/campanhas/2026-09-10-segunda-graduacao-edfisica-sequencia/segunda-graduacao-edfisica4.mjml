<mjml>
  <mj-head>
    <mj-title>Última chance: Pós grátis na 2ª Graduação em Educação Física — San Educacional</mj-title>
    <mj-font
      name="Poppins"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap"
    />
    <mj-attributes>
      <mj-all font-family="Poppins, Arial, sans-serif" />
      <mj-text font-size="16px" color="#050505" line-height="24px" />
    </mj-attributes>
  </mj-head>

  <mj-body background-color="#bb0185" width="602px">
    <mj-wrapper padding="0px">
      <!-- Header -->
      <mj-section background-color="#bb0185" padding="28px 0px 22px">
        <mj-column>
          <mj-image
            src="https://imghost.saneducacional.com.br/3ZOcg.png"
            alt="San Educacional"
            width="220px"
            align="center"
            padding="0px"
          />
        </mj-column>
      </mj-section>

      <!-- Faixa última chance -->
      <mj-section background-color="#bb0185" padding="0px 16px 22px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="
                background-color: #f84806;
                border-radius: 22px;
                padding: 7px 14px;
                text-align: center;
              "
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 12px;
                  line-height: 16px;
                  color: #ffffff;
                  letter-spacing: 1.08px;
                  text-align: center;
                "
              >
                ⏰ ÚLTIMA CHANCE · A PÓS GRÁTIS ACABA HOJE
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Hero full-bleed -->
      <mj-section background-color="#fdfbf5" padding="0px">
        <mj-column>
          <mj-image
            src="https://imghost.saneducacional.com.br/phAYQ.jpg?w=1200"
            alt="Última chance: Pós-graduação grátis na Segunda Graduação em Educação Física"
            fluid-on-mobile="true"
            padding="0px"
          />
        </mj-column>
      </mj-section>

      <!-- Card headline + checklist -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 18px;
                  line-height: 25px;
                  color: #bb0185;
                "
              >
                {$name|default('Estudante')}, última chance de garantir sua Pós-graduação grátis fazendo a Segunda Graduação em Educação Física.
              </div>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 16px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Pós-graduação grátis, inclusa na Segunda Graduação
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Educação Física está presente na educação básica brasileira
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Possibilidade de atuação em escolas públicas e particulares
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Oportunidades em diferentes redes e contextos educacionais
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Aproveitamento de disciplinas da sua formação anterior
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Diploma reconhecido pelo MEC
                  </td>
                </tr>
              </table>

              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse; margin-top: 12px"
              >
                <tr>
                  <td width="26" valign="top" style="padding: 0">
                    <div
                      style="
                        width: 26px;
                        height: 26px;
                        background-color: #fdebf6;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 26px;
                        font-size: 12px;
                        color: #bb0185;
                      "
                    >
                      ✓
                    </div>
                  </td>
                  <td
                    valign="top"
                    style="
                      padding-left: 12px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 14px;
                      line-height: 21px;
                      color: #050505;
                    "
                  >
                    Piso salarial de professor a partir de R$4.000
                  </td>
                </tr>
              </table>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Callout laranja -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #f84806; border-radius: 22px; padding: 24px 22px"
            >
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td width="54" valign="middle" style="padding: 0">
                    <div
                      style="
                        width: 54px;
                        height: 54px;
                        background-color: #fa6a37;
                        border-radius: 999px;
                        text-align: center;
                        line-height: 54px;
                        font-size: 24px;
                      "
                    >
                      🎁
                    </div>
                  </td>
                  <td
                    valign="middle"
                    style="
                      padding-left: 14px;
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 600;
                      font-size: 15px;
                      line-height: 23px;
                      color: #ffffff;
                      text-align: left;
                    "
                  >
                    Se você já pensou em fazer uma segunda graduação, a Licenciatura em Educação Física pode ser uma forma estratégica de expandir seu currículo: e com a Pós-graduação grátis ativa, sair com dois diplomas pelo preço de um.
                  </td>
                </tr>
              </table>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Card vagas -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 0px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="background-color: #ffffff; border-radius: 22px; padding: 26px 22px"
            >
              <table
                role="presentation"
                width="100%"
                cellpadding="0"
                cellspacing="0"
                style="border-collapse: collapse"
              >
                <tr>
                  <td
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 14px;
                      color: #050505;
                    "
                  >
                    🔥 Vagas preenchidas
                  </td>
                  <td
                    align="right"
                    style="
                      font-family: Poppins, Arial, sans-serif;
                      font-weight: 700;
                      font-size: 22px;
                      color: #f84806;
                      letter-spacing: -0.66px;
                      text-align: right;
                    "
                  >
                    90%
                  </td>
                </tr>
              </table>
              <div
                style="
                  height: 10px;
                  background-color: #f4e3ee;
                  border-radius: 999px;
                  margin-top: 18px;
                "
              >
                <div
                  style="
                    height: 10px;
                    width: 90%;
                    background-color: #f84806;
                    border-radius: 999px;
                  "
                ></div>
              </div>
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 400;
                  font-size: 13px;
                  line-height: 20px;
                  color: #5b4a55;
                  margin-top: 14px;
                "
              >
                As vagas com essa condição já estão 90% preenchidas.
              </div>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Box de fechamento -->
      <mj-section background-color="#fdfbf5" padding="16px 16px 16px">
        <mj-column>
          <mj-text padding="0px">
            <div
              style="
                background-color: #bb0185;
                border-radius: 22px;
                padding: 30px 24px;
                text-align: center;
              "
            >
              <div
                style="
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 20px;
                  line-height: 27px;
                  color: #fff8fd;
                  letter-spacing: -0.4px;
                  text-align: center;
                "
              >
                Sua graduação atual não precisa ser o ponto final. Ela pode ser o ponto de partida para uma nova habilitação, com a pós já inclusa.
              </div>
              <a
                href="https://mailingredirect.saneducacional.com.br/redirect.php?codlead={$codlead}&amp;produto=10&amp;fornecedor=07&amp;nome_produto=Graduação&amp;curso=000&amp;nome_curso=Educação Física"
                style="
                  display: block;
                  background-color: #fff8fd;
                  color: #8d005e;
                  font-family: Poppins, Arial, sans-serif;
                  font-weight: 700;
                  font-size: 15px;
                  line-height: 20px;
                  text-align: center;
                  text-decoration: none;
                  border-radius: 999px;
                  padding: 16px 20px;
                  box-shadow: 0 4px 0 #f84806;
                  margin-top: 24px;
                "
              >
                Quero garantir minha pós grátis
              </a>
            </div>
          </mj-text>
        </mj-column>
      </mj-section>

      <!-- Footer -->
      <mj-section background-color="#8d005e" padding="24px 22px 34px">
        <mj-column>
          <mj-text align="center" padding="0px">
            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-weight: 600;
                font-size: 13px;
                line-height: 19px;
                color: #f0d0e7;
                text-align: center;
              "
            >
              0800 145 2300 ·
            </div>
            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-weight: 600;
                font-size: 13px;
                line-height: 19px;
                color: #f0d0e7;
                text-align: center;
                margin-top: 2px;
              "
            >
              @saneducacional
            </div>
          </mj-text>
          <mj-divider border-color="#ad4589" border-width="1px" padding="18px 0" />
          <mj-text align="center" padding="0px">
            <div
              style="
                font-family: Poppins, Arial, sans-serif;
                font-size: 13px;
                line-height: 19px;
                text-align: center;
              "
            >
              <a href="{$unsubscribe}" style="color: #f0d0e7; text-decoration: underline"
                >Descadastre-se</a
              >
            </div>
          </mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
